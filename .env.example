# MapLead — environment configuration
# Copy this file to `.env` and fill in your values.
#
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env

# ─── Backend selection ──────────────────────────────────────────────────────
# Options:  playwright (default, free, fragile) | outscraper (paid, robust) | serpapi
SCRAPER_BACKEND=playwright

# ─── API keys (only needed if SCRAPER_BACKEND != playwright) ────────────────
# Outscraper — sign up at https://app.outscraper.com/profile
# Free tier: ~100 records/month. Paid: ~$1/1000 records.
OUTSCRAPER_API_KEY=

# SerpApi — sign up at https://serpapi.com/manage-api-key
# $50/mo for 5000 searches, then $0.01/search.
SERPAPI_API_KEY=

# ─── Misc ───────────────────────────────────────────────────────────────────
# Default locale for the UI selector (en, de, fr, es, it, pt-BR, ja, ko, zh-CN, ar)
MAPLEAD_LOCALE=en
